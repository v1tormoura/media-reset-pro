{
  "name": "media-reset-pro",
  "version": "0.1.0",
  "private": true,
  "description": "Processamento local em lote de vídeo e imagem",
  "main": "dist-electron/bootstrap.js",
  "packageManager": "npm@11.12.1",
  "engines": { "node": "24.15.0", "npm": "11.12.1" },
  "scripts": {
    "dev": "concurrently -k \"vite\" \"wait-on http://127.0.0.1:5173 && electron .\"",
    "build": "tsc -b && vite build && tsc -p electron/tsconfig.json",
    "dist": "npm run build && electron-builder --win nsis",
    "dist:diagnose": "node scripts/dist-diagnostic.cjs",
    "verify:package": "node scripts/verify-package.cjs",
    "diagnose:nsis": "node scripts/diagnose-nsis-failure.cjs",
    "verify:native": "node scripts/verify-native.cjs",
    "verify:release": "node scripts/verify-release.cjs",
    "start": "electron .",
    "test": "vitest run"
  },
  "dependencies": {
    "lucide-react": "0.468.0",
    "react": "18.3.1",
    "react-dom": "18.3.1",
    "sharp": "0.35.5"
  },
  "devDependencies": {
    "@types/node": "22.20.5",
    "@types/react": "18.3.31",
    "@types/react-dom": "18.3.7",
    "@vitejs/plugin-react": "6.1.2",
    "concurrently": "9.2.5",
    "electron": "45.2.1",
    "electron-builder": "26.18.0",
    "typescript": "5.9.3",
    "vite": "8.3.5",
    "vitest": "5.0.5",
    "wait-on": "8.0.5"
  },
  "build": {
    "appId": "com.mediareset.pro",
    "productName": "Media Reset Pro",
    "directories": {
      "output": "release"
    },
    "files": [
      "dist/**",
      "dist-electron/**",
      "node_modules/**",
      "package.json"
    ],
    "win": {
      "target": [
        "nsis"
      ]
    },
    "asarUnpack": ["**/node_modules/sharp/**/*", "**/node_modules/@img/**/*"],
    "toolsets": { "nsis": "1.2.1" },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true
    }
  }
}
